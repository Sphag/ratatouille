# Deny the entire workspace; admit only runtime sources and locked build inputs.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!README.md
!LICENSE
!alembic.ini
!data/
!data/starter_recipes.json
!src/
!src/ratatouille/
!src/ratatouille/*.py
!src/ratatouille/data/
!src/ratatouille/data/*.json
!migrations/
!migrations/*.py
!migrations/script.py.mako
!migrations/versions/
!migrations/versions/*.py
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/*.ts
!frontend/src/*.tsx
!frontend/src/*.css
!assets/
!assets/icon.png
